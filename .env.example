# Groq API Key (Required for LLM inferences)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vector DB Selection: "chroma" (default, local) or "pinecone"
VECTOR_DB=chroma

# Optional Pinecone API Key (only required if VECTOR_DB=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
